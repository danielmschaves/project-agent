# Environment
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.log

# Derived data (regenerated from events.ndjson)
data/warehouse.duckdb

# LLM response cache (large, machine-local)
data/cache/

# Pipeline runtime outputs — never commit on dev branches
# (pipeline uses git add -f on auto/* branches for project outputs)
data/*.ndjson
data/runs/*.json

# Per-project generated outputs
projects/*/events.ndjson
projects/*/project.md
projects/*/reports/

# Ingest/parse state manifests
projects/*/sources/manifest.json
projects/*/sources/parse_manifest.json

# Portfolio reports
reports/*.html
reports/*.md

# IDE
.vscode/
.idea/

# Local-only design documents (for the maintainer; not part of the public repo)
ARCHITECTURE.md
REVIEW_NOTES.md

# Claude Code local settings and worktrees (machine-specific)
.claude/settings.local.json
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

.pytest_cache/
