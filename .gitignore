# Environment
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.log

# Derived data (regenerated from events.ndjson)
data/warehouse.duckdb

# LLM response cache (large, machine-local)
data/cache/

# Pipeline runtime outputs — never commit on dev branches
# (pipeline uses git add -f on auto/* branches for project outputs)
data/*.ndjson
data/runs/*.json

# Per-project generated outputs
projects/*/events.ndjson
projects/*/project.md
projects/*/reports/

# Research lane runtime outputs (same policy as a project)
research/events.ndjson
research/raw/manifest.json
research/raw/parse_manifest.json

# Ingest/parse state manifests
projects/*/raw/manifest.json
projects/*/raw/parse_manifest.json
projects/*/raw/compile_manifest.json

# NOTE: kb/ is deliberately NOT ignored. The compiled wiki is the readable
# source of truth and must be present on a fresh clone, or the Obsidian
# vault opens empty. Pipeline runs therefore dirty kb/ on dev branches.

# Portfolio reports
reports/*.html
reports/*.md

# Obsidian — vault config is committed; per-machine UI state is not
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/

# IDE
.vscode/
.idea/

# Local-only design documents (for the maintainer; not part of the public repo)
ARCHITECTURE.md
REVIEW_NOTES.md

# Claude Code local settings and worktrees (machine-specific)
.claude/settings.local.json
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

.pytest_cache/
